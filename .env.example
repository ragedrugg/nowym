# ============================================================
#  Шаблон переменных окружения для nowym.
#  Скопируй в .env и заполни значения. НЕ коммить настоящий .env.
# ============================================================

# ---- Telegram ----------------------------------------------
# Токен бота от @BotFather. Не забудь там же /setinline и
# /setinlinefeedback → 100% — без них инлайн не работает, см. README.
TELEGRAM_BOT_TOKEN=
# ID канала-кэша (создай приватный канал, добавь бота админом). Узнать id:
# перешли любое сообщение ИЗ канала боту @userinfobot. Формат: -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=
# Твой Telegram ID (для админских /health, /broadcast и алертов об ошибках
# в личку). Узнать: напиши боту @userinfobot.
ADMIN_USER_ID=

# ---- Postgres ----------------------------------------------
# Две изолированные БД: users (токены, encrypted) и cache (file_id треков).
# install.sh накатывает роли и прописывает эти DSN сам. Руками — создание
# см. в README, формат:
#   POSTGRES_USERS_DSN=postgresql://nowym_users_app:PASSWORD@127.0.0.1:5432/nowym_users
#   POSTGRES_CACHE_DSN=postgresql://nowym_cache_app:PASSWORD@127.0.0.1:5432/nowym_cache
POSTGRES_USERS_DSN=
POSTGRES_CACHE_DSN=
DB_POOL_MIN=1
DB_POOL_MAX=5

# ---- Шифрование токенов at-rest (Fernet) -------------------
# install.sh генерит сам. Руками:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
TOKEN_ENCRYPTION_KEY=

# ---- Логирование -------------------------------------------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# human / json
LOG_FORMAT=human

# ---- Inline-кэш --------------------------------------------
MEMORY_CACHE_SIZE=500
MEMORY_CACHE_TTL=600
CACHE_CLEANUP_INTERVAL=60

# ---- Поиск -------------------------------------------------
# Лимит результатов на inline-запрос (Telegram cap = 50)
MAX_SEARCH_RESULTS=5

# ---- HTTP клиент -------------------------------------------
HTTP_CONNECTION_LIMIT=100
HTTP_LIMIT_PER_HOST=30

# ---- Яндекс.Музыка -----------------------------------------
# Интервал между запросами к API (секунды). Меньше — агрессивнее, выше шанс 429.
YANDEX_RATE_LIMIT_INTERVAL=1.0
YANDEX_MAX_RETRIES=3

# OAuth Device Flow. Дефолты те же, что использует библиотека yandex-music —
# переопредели только если Яндекс отзовёт ключ или нужны свои.
# YANDEX_OAUTH_CLIENT_ID=23cabbbdc6cd418abb4b39c32c41195d
# YANDEX_OAUTH_CLIENT_SECRET=53bc75238f0c4d08a118e51fe9203300

# ---- Параллелизм скачивания -------------------------------
# Сколько треков качается параллельно суммарно
DOWNLOAD_QUEUE_CONCURRENCY=6
# Сколько треков альбома готовятся параллельно для одного пользователя
ALBUM_PARALLEL_TRACKS=4

# ---- Rate limits ------------------------------------------
# Inline-поиск: burst до 20, пополнение 2/сек
RATE_INLINE_MAX_TOKENS=20.0
RATE_INLINE_RATE_PER_SEC=2.0
# Тяжёлые операции (выгрузка альбома, /np): burst 3, пополнение 1/10сек
RATE_DOWNLOAD_MAX_TOKENS=3.0
RATE_DOWNLOAD_RATE_PER_SEC=0.1

# ---- Подключение к Telegram ---------------------------------
# Обязателен РОВНО один из двух блоков — этот или Webhook ниже. См. README,
# «Быстрый старт».
#
# self-hosted Bot API сервер (long-polling, без домена и TLS). URL — с /bot
# на конце, токен и метод бот доклеивает сам. Пример для локального docker:
#   BOT_API_BASE_URL=http://127.0.0.1:8081/bot
BOT_API_BASE_URL=

# ---- Webhook (нужен ТОЛЬКО если не задан BOT_API_BASE_URL выше) --------
# Публичный URL домена, на который Telegram шлёт апдейты. Пример:
#   WEBHOOK_HOST=https://your-domain.example
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook/nowym
# На каком интерфейсе/порту слушает встроенный http(s)-сервер. Telegram
# разрешает вебхуки на портах 443/80/88/8443.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8443
# TLS — пути к серту (напр. certbot). Должны быть читаемы пользователем, под
# которым запущен бот. Пример:
#   WEBHOOK_SSL_CERT=/etc/letsencrypt/live/your-domain.example/fullchain.pem
#   WEBHOOK_SSL_KEY=/etc/letsencrypt/live/your-domain.example/privkey.pem
WEBHOOK_SSL_CERT=
WEBHOOK_SSL_KEY=
# Опционально: секрет в заголовке X-Telegram-Bot-Api-Secret-Token.
# install.sh генерит сам. Руками:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
WEBHOOK_SECRET=

# ---- Лирика --------------------------------------------------
# Ключ Genius (genius.com/api-clients) — точнее находит текст по фразе,
# чем фолбэк на Yandex. Пусто — лирика всё равно работает, просто только
# через Yandex (покрытие андеграунда/рэпа заметно хуже).
GENIUS_TOKEN=

# ---- Now-playing endpoint ----------------------------------
# Bearer-токен для GET /now-playing. Пусто = endpoint всегда отдаёт 401.
# install.sh генерит сам. Руками:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
NOW_PLAYING_TOKEN=
# user_id владельца, под чьим Yandex-токеном держим ws с Ynison.
# По умолчанию = ADMIN_USER_ID. Переопредели если хочешь другого юзера.
# OWNER_ID=

# ---- Иконки кнопок ------------------------------------------
# Telegram custom-emoji стикерпак для иконок кнопок меню. Дефолт
# "tgiosicons" — публичный пак, работает без всякой настройки. Своя
# подборка — через @Stickers в Telegram ("Custom emoji" → создать/
# привязать к своему боту); эмодзи, которых нет в паке, просто рисуются
# обычным текстовым глифом — не критично.
# ICON_SET_NAME=tgiosicons
