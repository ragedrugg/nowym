# ============================================================
#  Шаблон переменных окружения для nowspot.
#  Скопируй в .env и заполни значения. НЕ коммить настоящий .env.
# ============================================================

# ---- Telegram ----------------------------------------------
# Токен бота от @BotFather. Не забудь там же /setinline и
# /setinlinefeedback → 100% — без них инлайн не работает, см. README.
TELEGRAM_BOT_TOKEN=
# ID канала-кэша (создай приватный канал, добавь бота админом). Узнать id:
# перешли любое сообщение ИЗ канала боту @userinfobot. Формат: -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=
# Твой Telegram ID (для админских /health, /broadcast и алертов об ошибках
# в личку). Узнать: напиши боту @userinfobot.
ADMIN_USER_ID=

# ---- Spotify ------------------------------------------------
# Client ID приложения Spotify. Создать на developer.spotify.com/dashboard →
# Create app. Redirect URI зависит от того, как ты подключаешь бота:
#   • webhook-режим (задан WEBHOOK_HOST ниже): используй
#     https://<твой-домен>/spotify/callback — бот сам ловит callback.
#   • long-polling / paste-режим: используй http://127.0.0.1:8888/callback,
#     юзер после авторизации пришлёт боту значение параметра code= из
#     адресной строки. Локальный сервер поднимать не нужно — Spotify просто
#     редиректит браузер, ошибка соединения ожидаема, важно взять `code=`.
# Client Secret Spotify для PKCE не нужен (используется code_challenge/verifier).
SPOTIFY_CLIENT_ID=

# Интервал polling'а /me/player/currently-playing в мс. Меньше = быстрее
# обновляется карточка «сейчас играет», больше нагрузка на Spotify API.
# SPOTIFY_NP_POLL_MS=3000
# Интервал между произвольными запросами к API (сек) и число ретраев на 429.
# SPOTIFY_RATE_LIMIT_INTERVAL=0.2
# SPOTIFY_MAX_RETRIES=3

# ---- Postgres ----------------------------------------------
# Две изолированные БД: users (токены, encrypted) и cache (file_id треков).
# install.sh накатывает роли и прописывает эти DSN сам. Руками — создание
# см. в README, формат:
#   POSTGRES_USERS_DSN=postgresql://nowspot_users_app:PASSWORD@127.0.0.1:5432/nowspot_users
#   POSTGRES_CACHE_DSN=postgresql://nowspot_cache_app:PASSWORD@127.0.0.1:5432/nowspot_cache
POSTGRES_USERS_DSN=
POSTGRES_CACHE_DSN=
DB_POOL_MIN=1
DB_POOL_MAX=5

# Только для docker-compose: пароли, которыми docs/sql/docker-init.sh создаёт
# роли nowspot_users_app/nowspot_cache_app при первом старте postgres-контейнера.
# Должны совпадать с паролями внутри POSTGRES_USERS_DSN/POSTGRES_CACHE_DSN
# выше (там host будет `postgres`, не 127.0.0.1). При bare-metal через
# install.sh — не нужны, не трогай.
NOWSPOT_USERS_PASSWORD=
NOWSPOT_CACHE_PASSWORD=

# ---- Redis ---------------------------------------------------
# Пусто = ioredis-дефолт (127.0.0.1:6379) — то, что нужно для install.sh.
# Только для docker-compose: REDIS_HOST=redis (имя сервиса).
REDIS_HOST=
REDIS_PORT=6379

# ---- Шифрование токенов at-rest (Fernet) -------------------
# install.sh генерит сам. Руками:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
TOKEN_ENCRYPTION_KEY=

# ---- Логирование -------------------------------------------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# human / json
LOG_FORMAT=human

# ---- Inline-кэш --------------------------------------------
MEMORY_CACHE_SIZE=500
MEMORY_CACHE_TTL=600
CACHE_CLEANUP_INTERVAL=60

# ---- Поиск -------------------------------------------------
# Лимит результатов на inline-запрос (Telegram cap = 50)
MAX_SEARCH_RESULTS=5

# ---- HTTP клиент -------------------------------------------
HTTP_CONNECTION_LIMIT=100
HTTP_LIMIT_PER_HOST=30

# ---- Параллелизм скачивания -------------------------------
# Сколько треков (yt-dlp) качается параллельно суммарно
DOWNLOAD_QUEUE_CONCURRENCY=6
# Сколько треков альбома готовятся параллельно для одного пользователя
ALBUM_PARALLEL_TRACKS=4

# ---- Rate limits ------------------------------------------
# Inline-поиск: burst до 20, пополнение 2/сек
RATE_INLINE_MAX_TOKENS=20.0
RATE_INLINE_RATE_PER_SEC=2.0
# Тяжёлые операции (выгрузка альбома, /np): burst 3, пополнение 1/10сек
RATE_DOWNLOAD_MAX_TOKENS=3.0
RATE_DOWNLOAD_RATE_PER_SEC=0.1

# ---- Подключение к Telegram ---------------------------------
# Обязателен РОВНО один из двух блоков — этот или Webhook ниже. См. README,
# «Быстрый старт».
#
# self-hosted Bot API сервер (long-polling, без домена и TLS). URL — с /bot
# на конце, токен и метод бот доклеивает сам. Пример для локального docker:
#   BOT_API_BASE_URL=http://127.0.0.1:8081/bot
BOT_API_BASE_URL=

# ---- Webhook (нужен ТОЛЬКО если не задан BOT_API_BASE_URL выше) --------
# Публичный URL домена, на который Telegram шлёт апдейты. Пример:
#   WEBHOOK_HOST=https://your-domain.example
# Если задан — Spotify OAuth-callback ждём тут же (/spotify/callback), без
# paste-кода в чат.
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook/nowspot
# На каком интерфейсе/порту слушает встроенный http(s)-сервер. Telegram
# разрешает вебхуки на портах 443/80/88/8443.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8443
# TLS — пути к серту (напр. certbot). Должны быть читаемы пользователем, под
# которым запущен бот. Пример:
#   WEBHOOK_SSL_CERT=/etc/letsencrypt/live/your-domain.example/fullchain.pem
#   WEBHOOK_SSL_KEY=/etc/letsencrypt/live/your-domain.example/privkey.pem
WEBHOOK_SSL_CERT=
WEBHOOK_SSL_KEY=
# Опционально: секрет в заголовке X-Telegram-Bot-Api-Secret-Token.
# install.sh генерит сам. Руками:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
WEBHOOK_SECRET=

# ---- Лирика --------------------------------------------------
# Ключ Genius (genius.com/api-clients) — единственный источник лирики
# (Spotify API текста песен не отдаёт). Пусто = лирики не будет вовсе.
GENIUS_TOKEN=

# ---- Now-playing endpoint ----------------------------------
# Bearer-токен для GET /now-playing. Пусто = endpoint всегда отдаёт 401.
# install.sh генерит сам. Руками:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
NOW_PLAYING_TOKEN=
# user_id владельца, под чьим Spotify-токеном идёт polling
# /me/player/currently-playing. По умолчанию = ADMIN_USER_ID.
# OWNER_ID=

# ---- Иконки кнопок ------------------------------------------
# Telegram custom-emoji стикерпак для иконок кнопок меню. Дефолт
# "tgiosicons" — публичный пак, работает без всякой настройки. Своя
# подборка — через @Stickers в Telegram ("Custom emoji" → создать/
# привязать к своему боту); эмодзи, которых нет в паке, просто рисуются
# обычным текстовым глифом — не критично.
# ICON_SET_NAME=tgiosicons
