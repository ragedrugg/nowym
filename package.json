{
  "name": "nowym-ts",
  "version": "1.7.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Yandex Music Telegram bot — TypeScript port of nowym",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
